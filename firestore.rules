rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Inloggad. Konton med e-post och lösenord måste ha bekräftat adressen (länken i mejlet).
    // Apple och Google har redan bekräftat sina adresser.
    function signedIn() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true);
    }
    // Appens ägare: får läsa allt för översikten och support, men inte ändra något.
    function isAdmin() {
      return signedIn() && request.auth.uid == 'mjQJQzsMCpVURkuVSyK5ctKVhG23';
    }
    // Hushållets ägare: den som skapade hushållet, eller den som ägaren lämnade över till.
    // Plus ändrar inte vem som är ägare.
    function ownerOf(d) {
      return d.get('owner', d.members[0]);
    }
    function memberOf(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Inbjudningskoder: går att slå upp en och en (inte lista) för den som är inloggad.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && memberOf(request.resource.data.householdId);
      // Medlemmar får uppdatera hushållets namn i inbjudan, inget annat.
      allow update: if signedIn() && memberOf(resource.data.householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['houseName']);
      allow delete: if signedIn() && memberOf(resource.data.householdId);
    }

    // Servicebok som delas med en köpare: vem som helst med länken kan läsa just den, ingen kan lista alla.
    match /shares/{token} {
      allow get: if true;
      allow create: if signedIn() && memberOf(request.resource.data.householdId);
      allow update: if signedIn() && memberOf(resource.data.householdId) && request.resource.data.householdId == resource.data.householdId;
      allow delete: if signedIn() && memberOf(resource.data.householdId);
    }

    // Telefoner där servern kan starta rutan på låsskärmen (Live Activity) när en automatisk resa börjar.
    // Nyckeln är ett slumpat id som bara telefonen känner till. Bara servern läser.
    match /liveDevices/{key} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'lang', 'updatedAt']);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'lang', 'updatedAt', 'lastStart']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Felrapporter från appen: alla inloggade kan skicka en kort rapport, bara ägaren kan läsa dem.
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'hid', 'msg', 'where', 'stack', 'ver', 'ua', 'native', 'lang', 'at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && (!('stack' in request.resource.data) || request.resource.data.stack.size() <= 1500);
      allow read, delete: if isAdmin();
    }

    // Statistik över sökningar på registreringsnummer: skrivs av servern, läses av administratören.
    match /regstats/{id} {
      allow read: if isAdmin();
    }

    match /households/{hid} {
      allow read: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid] && !('plus' in request.resource.data)
        && (!('owner' in request.resource.data) || request.resource.data.owner == request.auth.uid);
      allow update: if signedIn() && (
        // Medlemmar får ändra hushållet. Plus skrivs bara av servern när någon har betalat.
        // Bara ägaren får ta bort andra, byta ägare och välja vilken bil som fungerar utan Plus.
        // Andra får bara ta bort sig själva (Lämna).
        // Ägaren måste alltid vara någon som är med i hushållet.
        (request.auth.uid in resource.data.members && request.resource.data.members.size() > 0
          && ownerOf(request.resource.data) in request.resource.data.members
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plus'])
          && (ownerOf(resource.data) == request.auth.uid
            || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'activeCar', 'activeCarAt'])
              && (request.resource.data.members.toSet() == resource.data.members.toSet()
                || resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet()))))
        // Den som inte är medlem får bara lägga till sig själv, och bara med en giltig inbjudningskod.
        || (
          !(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinedWith'])
          // Den som går med får bara skriva sitt eget namn och sin egen e-post, inte ändra de andras.
          && (!('memberInfo' in resource.data) || request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.householdId == hid
        )
      );
      // Den sista medlemmen får radera hushållet, när kontot raderas.
      allow delete: if signedIn() && resource.data.members == [request.auth.uid];

      // Bilar, loggar och bilder: bara hushållets medlemmar.
      // Räknaren för AI-anrop (ai/{månad}) skrivs bara av servern.
      match /{coll}/{document=**} {
        allow read: if memberOf(hid) || isAdmin();
        allow create: if memberOf(hid) && coll != "ai";
        // Bara ägaren lägger en bil i papperskorgen (deletedAt) eller tar ut den.
        allow update: if memberOf(hid) && coll != "ai"
          && (coll != "cars" || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt', 'deletedBy'])
            || ownerOf(get(/databases/$(database)/documents/households/$(hid)).data) == request.auth.uid);
        // Bara hushållets ägare får ta bort en bil.
        allow delete: if memberOf(hid) && coll != "ai"
          && (coll != "cars" || ownerOf(get(/databases/$(database)/documents/households/$(hid)).data) == request.auth.uid);
      }
    }
  }
}
